NODE_ENV=development
PORT=8001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hydro_hitch_v2?replicaSet=rs0
LOG_LEVEL=info
TRUST_PROXY=0
SERVE_STATIC=false
# Optional SMTP for password recovery. Without it development writes .runtime/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Development seeding only; set your own password (12-72 UTF-8 bytes).
SEED_PASSWORD=
